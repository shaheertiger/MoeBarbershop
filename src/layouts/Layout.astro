---
import "../styles/global.css";
import { site } from "../data/site";
import { googleAds, consentRequiredRegions } from "../data/tracking";

interface Props {
  title?: string;
  description?: string;
  /** Path-only canonical override, e.g. "/blog". Defaults to the current URL. */
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  /** Optional JSON-LD objects injected into <head>. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Article metadata (only used when type === "article"). */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  /** Comma-separated keywords for the keywords meta tag. */
  keywords?: string;
}

const {
  title = "Moe's Barbershop | Barber in Erin, Ontario",
  description = "Moe's Barbershop in Erin, Ontario — classic cuts, skin fades, beard grooming and kids' cuts. Rated 5.0 on Google. Book your appointment online today.",
  canonicalPath,
  image = "/images/hero-barbershop.jpg",
  type = "website",
  jsonLd = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  keywords = "barber Erin Ontario, barbershop Erin, men's haircut Erin, skin fade, beard trim, beard lineup, kids haircut, Moe's Barbershop",
} = Astro.props;

const siteUrl = "https://www.moesbarbershop.ca";
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }
    <meta name="author" content={author ?? "Moe's Barbershop"} />
    <meta name="keywords" content={keywords} />
    <meta name="theme-color" content="#5a2d20" />
    <meta name="geo.region" content="CA-ON" />
    <meta name="geo.placename" content="Erin, Ontario" />
    <meta name="geo.position" content="43.783;-80.133" />
    <meta name="ICBM" content="43.783, -80.133" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Moe's Barbershop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_CA" />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === "article" && author && (
      <meta property="article:author" content={author} />
    )}
    {type === "article" &&
      tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Moe's Barbershop Blog"
      href="/rss.xml"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/logo.svg" />

    <!-- Google tag (gtag.js) — Google Ads. IDs and conversion labels live in
         src/data/tracking.ts. -->
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${googleAds.id}`}></script>
    <script
      is:inline
      define:vars={{
        ads: googleAds,
        consentRegions: consentRequiredRegions,
        bookingHost: new URL(site.bookingUrl).hostname,
      }}
    >
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      // Consent Mode v2: denied by default where Google requires opt-in
      // consent (no cookie banner here), granted everywhere else.
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        region: consentRegions,
      });
      gtag("consent", "default", {
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
        analytics_storage: "granted",
      });
      gtag("set", "ads_data_redaction", true);

      gtag("js", new Date());
      gtag("config", ads.id);

      // One capturing listener tracks every booking, call, directions and
      // email link on the page — header, mobile bar, price list and links
      // inside blog posts — with no per-element wiring.
      var eventNames = {
        booking: "booking_click",
        call: "phone_call_click",
        directions: "directions_click",
        email: "email_click",
      };
      var lastSent = {};

      function actionFor(link) {
        var href = link.getAttribute("href") || "";
        if (link.hasAttribute("data-book") || link.hostname === bookingHost) {
          return "booking";
        }
        if (href.indexOf("tel:") === 0) return "call";
        if (href.indexOf("mailto:") === 0) return "email";
        if (link.hasAttribute("data-directions")) return "directions";
        return null;
      }

      function onLinkClick(e) {
        // Clicks, taps and Enter fire "click"; middle-click "open in new tab"
        // only fires "auxclick".
        if (e.type === "auxclick" && e.button !== 1) return;
        var link = e.target.closest && e.target.closest("a[href]");
        var action = link && actionFor(link);
        if (!action) return;

        // Ignore the second click of a double-click.
        var now = Date.now();
        if (now - (lastSent[action] || 0) < 1500) return;
        lastSent[action] = now;

        var params = {
          link_url: link.href,
          link_text: (link.textContent || "").trim().slice(0, 100),
        };
        var service = link.getAttribute("data-book-service");
        var value = parseFloat(link.getAttribute("data-book-value"));
        if (service) params.service = service;
        if (value > 0) {
          params.value = value;
          params.currency = "CAD";
        }
        gtag("event", eventNames[action], params);

        var label = ads.conversions[action];
        if (label) {
          var conversion = { send_to: ads.id + "/" + label };
          if (value > 0) {
            conversion.value = value;
            conversion.currency = "CAD";
          }
          gtag("event", "conversion", conversion);
        }
      }

      document.addEventListener("click", onLinkClick, true);
      document.addEventListener("auxclick", onLinkClick, true);
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data)}
        />
      ))
    }
  </head>
  <body>
    <slot />

    <script is:inline>
      // Pages are prerendered, so today's opening hours are marked in the
      // browser (in shop time) rather than frozen at build time.
      (function () {
        var today = new Date().toLocaleDateString("en-US", {
          weekday: "long",
          timeZone: "America/Toronto",
        });
        document.querySelectorAll("[data-day]").forEach(function (el) {
          el.classList.toggle("is-today", el.getAttribute("data-day") === today);
        });
      })();
    </script>
  </body>
</html>
