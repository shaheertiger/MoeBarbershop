---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";
import {
  servicePages,
  servicePageJsonLd,
  type ServicePage,
} from "../../data/servicePages";

export async function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const others = servicePages.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<Layout
  title={`${service.metaTitle} | Moe's Barbershop`}
  description={service.metaDescription}
  canonicalPath={`/services/${service.slug}`}
  image={service.image}
  keywords={service.keywords}
  jsonLd={servicePageJsonLd(service)}
>
  <Header />
  <main>
    <article class="svc">
      <section class="svc-hero">
        <div class="container svc-hero-grid">
          <div class="svc-hero-text">
            <nav class="crumbs" aria-label="Breadcrumb">
              <a href="/">Home</a> / <a href="/services">Services</a> /
              <span>{service.metaTitle}</span>
            </nav>
            <h1>{service.title}</h1>
            <p class="lead">{service.summary}</p>
            <p class="meta">
              <span class="price">From {service.priceFrom}</span>
              <span class="dot">·</span>
              <span>{service.duration}</span>
              <span class="dot">·</span>
              <span>5.0★ on Google</span>
            </p>
            <div class="cta-row">
              <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
                Book This Service
              </a>
              <a class="btn btn-outline" href={site.phoneHref}>Call {site.phone}</a>
            </div>
          </div>
          <img
            class="svc-hero-img"
            src={service.image}
            alt={service.title}
            width="640"
            height="480"
            loading="eager"
          />
        </div>
      </section>

      <section class="section">
        <div class="container narrow">
          <div class="prose">
            {service.intro.map((p) => <p>{p}</p>)}
          </div>

          <h2 class="block-title">What's included</h2>
          <ul class="checklist">
            {service.highlights.map((h) => <li>{h}</li>)}
          </ul>

          {
            service.faqs.length > 0 && (
              <>
                <h2 class="block-title">Frequently asked questions</h2>
                <div class="faqs">
                  {service.faqs.map((f) => (
                    <details class="faq-item">
                      <summary>{f.q}</summary>
                      <p>{f.a}</p>
                    </details>
                  ))}
                </div>
              </>
            )
          }

          <div class="svc-cta">
            <h3>Ready for your {service.metaTitle.toLowerCase()}?</h3>
            <p>Book online at Moe's Barbershop in Erin, Ontario — or walk in when a chair's open.</p>
            <a class="btn btn-light" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
              Book an Appointment
            </a>
          </div>

          <h2 class="block-title">Other services</h2>
          <div class="other-grid">
            {
              others.map((o) => (
                <a class="other-card" href={`/services/${o.slug}`}>
                  <strong>{o.metaTitle}</strong>
                  <span>from {o.priceFrom}</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .svc-hero {
    background:
      radial-gradient(120% 90% at 85% -10%, rgba(224, 146, 47, 0.22), transparent 60%),
      linear-gradient(180deg, var(--cream-soft), var(--cream));
    padding: 48px 0 40px;
  }

  .svc-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 36px;
    align-items: center;
  }

  .crumbs {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 16px;
  }

  .crumbs a:hover {
    color: var(--orange);
  }

  .svc-hero-text h1 {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
  }

  .lead {
    font-size: 1.18rem;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    margin-bottom: 22px;
  }

  .meta .price {
    color: var(--orange);
    font-weight: 700;
  }

  .meta .dot {
    opacity: 0.5;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .svc-hero-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .narrow {
    max-width: 760px;
  }

  .prose {
    font-size: 1.08rem;
  }

  .block-title {
    font-size: 1.6rem;
    margin-top: 1.8em;
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 1em;
    display: grid;
    gap: 10px;
  }

  .checklist li {
    position: relative;
    padding-left: 30px;
    color: var(--ink);
  }

  .checklist li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--orange);
    font-weight: 800;
  }

  .faqs {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    background: var(--white);
    border: 1px solid rgba(90, 45, 32, 0.1);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--brown);
  }

  .faq-item p {
    margin: 10px 0 0;
    color: var(--muted);
  }

  .svc-cta {
    background: var(--brown);
    color: var(--cream);
    border-radius: var(--radius);
    padding: 32px;
    text-align: center;
    margin: 48px 0 8px;
  }

  .svc-cta h3 {
    color: var(--cream);
    margin-bottom: 6px;
    text-transform: capitalize;
  }

  .svc-cta p {
    color: rgba(240, 228, 204, 0.85);
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .other-card {
    background: var(--white);
    border: 1px solid rgba(90, 45, 32, 0.1);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: transform 0.16s ease, border-color 0.2s ease;
  }

  .other-card:hover {
    transform: translateY(-3px);
    border-color: rgba(224, 146, 47, 0.5);
  }

  .other-card strong {
    color: var(--brown);
  }

  .other-card span {
    color: var(--orange);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .svc-hero-grid {
      grid-template-columns: 1fr;
    }
    .svc-hero-img {
      order: -1;
    }
    .other-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
