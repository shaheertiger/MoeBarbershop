---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site, SITE_URL } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    // "Keep reading": the posts sharing the most tags, newest first.
    const shared = (p: typeof post) =>
      p.data.tags.filter((t) => post.data.tags.includes(t)).length;
    const related = posts
      .filter((p) => p.id !== post.id)
      .sort(
        (a, b) =>
          shared(b) - shared(a) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      )
      .slice(0, 3);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" });

const url = `${SITE_URL}/blog/${post.id}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": url,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author:
    post.data.author === "Moe"
      ? { "@type": "Person", "@id": `${SITE_URL}/about#moe`, name: "Moe", url: `${SITE_URL}/about` }
      : { "@type": "Person", name: post.data.author },
  publisher: {
    "@type": "Organization",
    "@id": `${SITE_URL}/#org`,
    name: "Moe's Barbershop",
    logo: { "@type": "ImageObject", url: `${SITE_URL}/logo.svg` },
  },
  image: `${SITE_URL}${post.data.heroImage ?? "/logo.svg"}`,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  keywords: post.data.tags.join(", "),
};

const faqJsonLd = post.data.faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.data.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};
---

<Layout
  title={`${post.data.title} | Moe's Barbershop`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
  type="article"
  image={post.data.heroImage ?? "/logo.svg"}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  author={post.data.author}
  tags={post.data.tags}
  jsonLd={[articleJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])]}
>
  <Header />
  <main>
    <article class="post">
      <div class="container narrow">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> / <a href="/blog">Blog</a>
        </nav>

        <header class="post-header">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {fmt(post.data.pubDate)}
            </time>
            <span>·</span>
            <span>By {post.data.author}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p class="lead">{post.data.description}</p>
        </header>

        {
          post.data.heroImage && (
            <img
              class="post-hero"
              src={post.data.heroImage}
              alt={post.data.heroAlt ?? post.data.title}
              width="1200"
              height="600"
              loading="eager"
            />
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          post.data.faqs.length > 0 && (
            <section class="post-faqs">
              <h2>Frequently asked questions</h2>
              <div class="faqs">
                {post.data.faqs.map((f) => (
                  <details class="faq-item">
                    <summary>{f.q}</summary>
                    <p>{f.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <div class="post-cta">
          <h3>Ready for a fresh cut?</h3>
          <p>Book your appointment at Moe's Barbershop in Erin, Ontario.</p>
          <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
            Book an Appointment
          </a>
        </div>

        {
          related.length > 0 && (
            <nav class="related" aria-label="More articles">
              <h2>Keep reading</h2>
              <ul>
                {related.map((r) => (
                  <li>
                    <a href={`/blog/${r.id}`}>{r.data.title}</a>
                    <p>{r.data.excerpt}</p>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <a class="back-link" href="/blog">← Back to all articles</a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .narrow {
    max-width: 760px;
  }

  .post {
    padding: 48px 0 72px;
  }

  .crumbs {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }

  .crumbs a:hover {
    color: var(--orange);
  }

  .post-meta {
    display: flex;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 14px;
  }

  .post-header h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .post-header .lead {
    font-size: 1.15rem;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .post-hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin: 28px 0 8px;
    box-shadow: var(--shadow);
  }

  .prose {
    font-size: 1.08rem;
    color: var(--ink);
    border-top: 1px solid rgba(90, 45, 32, 0.12);
    padding-top: 32px;
    margin-top: 24px;
  }

  .prose :global(h2) {
    font-size: 1.6rem;
    margin-top: 1.8em;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5em;
  }

  .prose :global(ul) {
    padding-left: 1.2em;
  }

  .prose :global(li) {
    margin-bottom: 0.5em;
  }

  .prose :global(a) {
    color: var(--orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.2em 0 1.6em;
    font-size: 0.98rem;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(90, 45, 32, 0.12);
  }

  .prose :global(th) {
    background: var(--cream);
    color: var(--brown);
    font-weight: 700;
  }

  .post-faqs {
    margin-top: 48px;
  }

  .post-faqs h2,
  .related h2 {
    font-size: 1.6rem;
  }

  .faqs {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    background: var(--white);
    border: 1px solid rgba(90, 45, 32, 0.1);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--brown);
  }

  .faq-item p {
    margin: 10px 0 0;
    color: var(--muted);
  }

  .post-cta {
    background: var(--brown);
    color: var(--cream);
    border-radius: var(--radius);
    padding: 32px;
    text-align: center;
    margin: 48px 0 32px;
  }

  .post-cta h3 {
    color: var(--cream);
    margin-bottom: 6px;
  }

  .post-cta p {
    color: rgba(240, 228, 204, 0.85);
  }

  .related {
    margin-bottom: 32px;
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .related li {
    background: var(--white);
    border: 1px solid rgba(90, 45, 32, 0.08);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .related a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--brown);
  }

  .related a:hover {
    color: var(--orange);
  }

  .related p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .back-link {
    font-weight: 600;
    color: var(--brown);
  }

  .back-link:hover {
    color: var(--orange);
  }

  @media (max-width: 640px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
