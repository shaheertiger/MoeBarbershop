---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<Layout
  title="Page Not Found | Moe's Barbershop"
  description="That page couldn't be found. Head back to Moe's Barbershop in Erin, Ontario to view services, areas we serve, and book your appointment."
  noindex={true}
>
  <Header />
  <main>
    <section class="nf">
      <div class="container">
        <p class="section-eyebrow">404</p>
        <h1>We couldn't find that page</h1>
        <p class="lead">
          The page you're after has moved or never existed — but your next sharp
          cut is still one click away.
        </p>
        <div class="links">
          <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
            Book an Appointment
          </a>
          <a class="btn btn-outline" href="/">Back to Home</a>
        </div>
        <nav class="quick" aria-label="Helpful links">
          <a href="/services">Services</a>
          <a href="/areas">Areas We Serve</a>
          <a href="/blog">Blog</a>
          <a href="/#location">Location &amp; Hours</a>
        </nav>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    text-align: center;
    padding: 96px 0;
  }
  .nf h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }
  .lead {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 520px;
    margin: 0 auto 28px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-bottom: 28px;
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    justify-content: center;
  }
  .quick a {
    font-weight: 600;
    color: var(--brown);
  }
  .quick a:hover {
    color: var(--orange);
  }
</style>
