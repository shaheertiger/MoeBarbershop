---
import { site } from "../data/site";
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="section-eyebrow">Erin, Ontario · Rated {site.rating} ★</p>
      <h1>Sharp cuts.<br />Classic vibes.</h1>
      <p class="hero-lead">
        Welcome to Moe's Barbershop — precision fades, beard grooming and timeless
        styles delivered with care and craftsmanship. Sit back, relax, and leave
        looking your best.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
          Book an Appointment
        </a>
        <a class="btn btn-outline" href="#services">View Services</a>
      </div>
      <div class="hero-meta">
        <a href={site.phoneHref}>📞 {site.phone}</a>
        <span>·</span>
        <span>📍 {site.address.line1}, {site.address.city}</span>
      </div>
    </div>

    <div class="hero-badge">
      <div class="hero-photo">
        <img
          src="/images/hero-barbershop.jpg"
          alt="Barber giving a straight-razor shave at Moe's Barbershop"
          width="1200"
          height="800"
          loading="eager"
        />
        <div class="badge-ring">
          <img src="/logo.svg" alt="Moe's Barbershop emblem" width="120" height="120" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(120% 90% at 80% -10%, rgba(224, 146, 47, 0.22), transparent 60%),
      linear-gradient(180deg, var(--cream-soft), var(--cream));
    padding: 80px 0 96px;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 800;
    margin-bottom: 18px;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 28px 0 22px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-weight: 500;
  }

  .hero-meta a {
    color: var(--brown);
  }

  .hero-badge {
    display: flex;
    justify-content: center;
  }

  .hero-photo {
    position: relative;
    width: min(440px, 88vw);
  }

  .hero-photo > img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .badge-ring {
    position: absolute;
    bottom: -26px;
    left: -26px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--cream);
    box-shadow: var(--shadow);
    animation: float 6s ease-in-out infinite;
  }

  .badge-ring img {
    width: 80%;
    height: auto;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (max-width: 820px) {
    .hero {
      padding: 32px 0 64px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 28px;
    }
    .hero h1 {
      margin-bottom: 12px;
    }
    .hero-lead {
      margin-inline: auto;
    }
    .hero-actions {
      margin: 22px 0 18px;
    }
    .hero-actions,
    .hero-meta {
      justify-content: center;
    }
    /* Keep the copy (and Book Now CTA) above the photo so the
       booking button stays in the first fold on mobile. */
    .hero-copy {
      order: -1;
    }
    .hero-actions .btn-primary {
      width: 100%;
    }
  }
</style>
