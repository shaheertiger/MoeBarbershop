---
import { site } from "../data/site";
---

<header class="header" id="top">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/logo.svg" alt="Moe's Barbershop logo" width="48" height="48" />
      <span class="brand-name">Moe's Barbershop</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/#services">Services</a>
      <a href="/#staff">Staff</a>
      <a href="/blog">Blog</a>
      <a href="/#location">Location &amp; Hours</a>
    </nav>

    <a class="btn btn-primary header-cta" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
      Book
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 239, 222, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(90, 45, 32, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand img {
    border-radius: 50%;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--brown);
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    gap: 30px;
  }

  .nav a {
    font-weight: 500;
    color: var(--ink);
    position: relative;
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 2px;
    background: var(--orange);
    transition: width 0.2s ease;
  }

  .nav a:hover::after {
    width: 100%;
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 460px) {
    .brand-name {
      display: none;
    }
  }
</style>
