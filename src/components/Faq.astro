---
import { faqs } from "../data/faq";
---

<section class="section faq" id="faq">
  <div class="container">
    <div class="section-head">
      <p class="section-eyebrow">Good to know</p>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p>Quick answers about visiting Moe's Barbershop in Erin, Ontario.</p>
    </div>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="chev" aria-hidden="true">+</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--cream-soft);
  }

  .faq-list {
    max-width: 820px;
  }

  .faq-item {
    background: var(--white);
    border: 1px solid rgba(90, 45, 32, 0.08);
    border-radius: var(--radius);
    padding: 4px 22px;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(58, 29, 20, 0.04);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 18px 0;
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--brown);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    font-size: 1.5rem;
    color: var(--orange);
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq-item[open] .chev {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin: 0;
    padding: 0 0 20px;
    color: var(--muted);
  }
</style>
