---
import { site } from "../data/site";
---

<section class="section reviews" id="reviews">
  <div class="container">
    <div class="reviews-card">
      <p class="section-eyebrow">Loved by locals</p>
      <div class="stars" aria-hidden="true">★★★★★</div>
      <p class="rating-line">
        Rated <strong>{site.rating}</strong> out of 5 by
        <strong>{site.reviewCount}+</strong> clients on Google
      </p>
      <p class="reviews-sub">
        Erin, Hillsburgh and Wellington County trust Moe's Barbershop for sharp,
        consistent cuts — every visit.
      </p>
      <div class="reviews-actions">
        <a class="btn btn-primary" href={site.mapsUrl} target="_blank" rel="noopener">
          Read our Google reviews
        </a>
        <a class="btn btn-outline" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
          Book Your Cut
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--cream);
  }

  .reviews-card {
    background: var(--white);
    border: 1px solid rgba(90, 45, 32, 0.08);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 48px 32px;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .stars {
    color: var(--orange);
    font-size: 2rem;
    letter-spacing: 4px;
    margin-bottom: 10px;
  }

  .rating-line {
    font-size: 1.4rem;
    font-family: var(--font-display);
    color: var(--brown);
    margin-bottom: 6px;
  }

  .rating-line strong {
    color: var(--orange);
  }

  .reviews-sub {
    color: var(--muted);
    max-width: 460px;
    margin: 0 auto 24px;
  }

  .reviews-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .reviews-card {
      padding: 32px 20px;
    }

    .reviews-actions {
      flex-direction: column;
    }

    .reviews-actions .btn {
      width: 100%;
    }
  }
</style>
