---
import { site } from "../data/site";
---

<section class="section staff" id="staff">
  <div class="container staff-inner">
    <div class="staff-media">
      <div class="staff-photo">
        <img src="/logo.svg" alt="Moe's Barbershop" width="220" height="220" />
      </div>
      <div class="rating-chip">
        <strong>{site.rating} ★</strong>
        <span>{site.reviewCount} Google reviews</span>
      </div>
    </div>

    <div class="staff-copy">
      <p class="section-eyebrow">Meet the barber</p>
      <h2 class="section-title">Moe</h2>
      <p>
        Moe is the heart of the shop — a barber with a sharp eye for detail and a
        passion for the craft. Whether it's a classic cut, a precise fade, or a
        clean beard lineup, Moe takes the time to get it right and make sure you
        leave looking and feeling your best.
      </p>
      <p>
        Drop by, grab a seat, and become part of the Moe's Barbershop family.
      </p>
      <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" data-book>
        Book with Moe
      </a>
    </div>
  </div>
</section>

<style>
  .staff {
    background: var(--brown);
    color: var(--cream);
  }

  .staff :global(.section-title),
  .staff h2 {
    color: var(--cream);
  }

  .staff-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 56px;
  }

  .staff-media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .staff-photo {
    width: min(320px, 80vw);
    aspect-ratio: 1;
    border-radius: 24px;
    background: var(--cream);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow);
  }

  .staff-photo img {
    width: 70%;
  }

  .rating-chip {
    position: absolute;
    bottom: -18px;
    right: 10%;
    background: var(--orange);
    color: var(--brown-dark);
    border-radius: 14px;
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
    box-shadow: var(--shadow);
  }

  .rating-chip strong {
    font-size: 1.3rem;
  }

  .rating-chip span {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .staff-copy p {
    color: rgba(240, 228, 204, 0.85);
    max-width: 520px;
  }

  .staff-copy .btn {
    margin-top: 10px;
  }

  @media (max-width: 820px) {
    .staff-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .staff-copy p {
      margin-inline: auto;
    }
  }
</style>
