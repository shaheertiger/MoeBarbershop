---
const shots = [
  {
    src: "/images/cut-side-part.jpg",
    alt: "Men's side-part haircut with a skin fade at Moe's Barbershop",
    label: "Side part & fade",
  },
  {
    src: "/images/cut-fade.jpg",
    alt: "Sharp men's fade haircut being shaped by the barber",
    label: "Clean fades",
  },
  {
    src: "/images/cut-curly-fade.jpg",
    alt: "Curly top with a skin fade and blonde tips",
    label: "Textured tops",
  },
  {
    src: "/images/cut-pompadour.jpg",
    alt: "Slick pompadour with a skin fade and full beard",
    label: "Pompadour & fade",
  },
  {
    src: "/images/cut-scissor.jpg",
    alt: "Close-up of a men's scissor haircut at Moe's Barbershop",
    label: "Precision cuts",
  },
  {
    src: "/images/cut-comb-fade.jpg",
    alt: "Barber combing a fresh fade from behind",
    label: "Sharp lineups",
  },
  {
    src: "/images/fade.jpg",
    alt: "Barber styling a fresh men's fade with a blow dryer",
    label: "Blow-out & style",
  },
  {
    src: "/images/cut-beard-profile.jpg",
    alt: "Men's haircut and beard trim, side profile",
    label: "Cut & beard",
  },
  {
    src: "/images/haircut.jpg",
    alt: "Scissor haircut in progress at Moe's Barbershop",
    label: "Classic cuts",
  },
];
---

<section class="section gallery" id="gallery">
  <div class="container">
    <div class="section-head">
      <p class="section-eyebrow">The work</p>
      <h2 class="section-title">In the Chair</h2>
      <p>A look at the cuts, fades and grooming we do every day in Erin.</p>
    </div>

    <div class="shots">
      {
        shots.map((s) => (
          <figure class="shot">
            <img src={s.src} alt={s.alt} loading="lazy" width="600" height="800" />
            <figcaption>{s.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--cream);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .shot {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(58, 29, 20, 0.08);
    aspect-ratio: 3 / 4;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .shot:hover img {
    transform: scale(1.06);
  }

  .shot figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
  }

  .shot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(45, 22, 14, 0.6), transparent 55%);
  }

  @media (max-width: 820px) {
    .shots {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .shots {
      grid-template-columns: 1fr;
    }
  }
</style>
