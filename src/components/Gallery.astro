---
const shots = [
  {
    src: "/images/haircut.jpg",
    alt: "Scissor haircut in progress at Moe's Barbershop",
    label: "Precision cuts",
  },
  {
    src: "/images/fade.jpg",
    alt: "Barber styling a fresh fade with a blow dryer",
    label: "Clean fades",
  },
  {
    src: "/images/beard-trim.jpg",
    alt: "Sharp fade and lineup viewed from behind",
    label: "Sharp lineups",
  },
  {
    src: "/images/barber-tools.jpg",
    alt: "Barber scissors, comb and dryer on a wooden bench",
    label: "Pro tools",
  },
];
---

<section class="section gallery" id="gallery">
  <div class="container">
    <div class="section-head">
      <p class="section-eyebrow">The work</p>
      <h2 class="section-title">In the Chair</h2>
      <p>A look at the cuts, fades and grooming we do every day in Erin.</p>
    </div>

    <figure class="banner">
      <img
        src="/images/shop-interior.jpg"
        alt="Inside Moe's Barbershop — vintage chairs, brick walls and warm lighting"
        loading="lazy"
        width="1200"
        height="600"
      />
      <figcaption>99 Trafalgar Rd · Erin, Ontario</figcaption>
    </figure>

    <div class="shots">
      {
        shots.map((s) => (
          <figure class="shot">
            <img src={s.src} alt={s.alt} loading="lazy" width="600" height="600" />
            <figcaption>{s.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--cream);
  }

  .banner {
    position: relative;
    margin: 0 0 18px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 21 / 9;
  }

  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner figcaption {
    position: absolute;
    left: 22px;
    bottom: 18px;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .shot {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(58, 29, 20, 0.08);
    aspect-ratio: 3 / 4;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .shot:hover img {
    transform: scale(1.06);
  }

  .shot figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
  }

  .shot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(45, 22, 14, 0.6), transparent 55%);
  }

  @media (max-width: 820px) {
    .shots {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
